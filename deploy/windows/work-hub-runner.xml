<?xml version="1.0" encoding="UTF-16"?>
<!--
  Template: `npm run setup` fills the __PLACEHOLDERS__ into data/deploy/ (UTF-16, as schtasks expects) and prints the
  install commands (docs/setup.md). Task Scheduler task: the Develop runner (src/runner/main.ts), separate from the hub
  so that restarting the hub never kills an AI turn. Starts at logon, restarts a minute after it fails.
  NOT YET TRIED ON A WINDOWS MACHINE: hidden console, restart on failure, and Develop itself on Windows.
  No .env here on purpose: the hub's tokens must not reach Develop turns.
  Logs:    data\work-hub-runner.log
  Restart, in PowerShell (a running turn is marked failed; ending the task likely stops only conhost, not node):
    Get-CimInstance Win32_Process -Filter "Name='node.exe'" | Where-Object CommandLine -like '*src\runner\main.ts*' | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }
    schtasks /Run /TN work-hub-runner
  Remove:  the Stop-Process line above, then schtasks /Delete /TN work-hub-runner /F
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>work-hub runner: Develop turns</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>__USER__</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>__USER__</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>%SystemRoot%\System32\conhost.exe</Command>
      <Arguments>--headless %SystemRoot%\System32\cmd.exe /d /c ""__NODE__" src\runner\main.ts &gt;&gt; data\work-hub-runner.log 2&gt;&amp;1"</Arguments>
      <WorkingDirectory>__REPO__</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
