{
  "name": "work-hub",
  "private": true,
  "type": "module",
  "description": "Work hub for one person: develop board, daily report, tracking, ops, user feedback. Each person runs their own copy.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "once": "node --env-file-if-exists=.env src/main.ts once",
    "test": "node --env-file=test/test.env --test \"test/**/*.ts\"",
    "check": "tsc -p . && node --env-file=test/test.env --test \"test/**/*.ts\"",
    "report:backfill": "node --env-file-if-exists=.env src/modules/report/backfill.ts",
    "track:backfill": "node --env-file-if-exists=.env src/modules/track/backfill.ts",
    "runner": "node src/runner/main.ts",
    "bridge:extension": "node src/modules/bridge/build.ts",
    "setup": "node deploy/setup.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
